#jinja2: trim_blocks:False, lstrip_blocks:False
apiVersion: v1
kind: Secret
metadata:
  name: {{ bridge_name }}-config
  namespace: {{ bridge_namespace }}
type: Opaque
stringData:
  config.yaml: |
    http:
      addr: ":{{ bridge_listen_port }}"
    ntfy:
      baseurl: {{ bridge_ntfy_baseurl }}
      auth:
        token: "{{ bridge_ntfy_token }}"
      notification:
        # Direct lookup. Prometheus's additionalAlertRelabelConfigs (in
        # kube-prometheus-stack helm values) guarantees the `topic` and
        # `severity` labels always exist by injecting defaults when missing.
        # Without that guarantee, plain gval.Full() throws "unknown
        # parameter labels.topic" on missing-key access — there's no
        # graceful idiom for map[string]string fallback in gval.Full() as
        # used by alertmanager-ntfy.
        topic: |
          labels.topic
        priority: |
          labels.severity == "critical" ? "high" : (labels.severity == "warning" ? "default" : "low")
        tags:
          - tag: rotating_light
            condition: status == "firing" && labels.severity == "critical"
          - tag: warning
            condition: status == "firing" && labels.severity == "warning"
          - tag: white_check_mark
            condition: status == "resolved"
        # Nagios/Zabbix-style layout: the title answers "what broke, where"
        # at a glance (that is often all that is visible on a phone), and the
        # body is a fixed HOST / SERVICE / STATE block followed by the
        # human-readable output. `host` is guaranteed by alert_relabel_configs
        # rules 4-5; `service` falls back to the alertname for bundled cluster
        # rules that have no human service name.
        templates:
          title: |
            {% raw %}{{ if eq .Status "resolved" }}[OK]{{ else if eq (index .Labels "severity") "critical" }}[CRIT]{{ else }}[WARN]{{ end }} {{ index .Labels "host" }} · {{ if index .Labels "service" }}{{ index .Labels "service" }}{{ else }}{{ index .Labels "alertname" }}{{ end }}{% endraw %}
          description: |
            {% raw %}{{ index .Annotations "summary" }}

            HOST     {{ index .Labels "host" }}
            SERVICE  {{ if index .Labels "service" }}{{ index .Labels "service" }}{{ else }}{{ index .Labels "alertname" }}{{ end }}
            STATE    {{ if eq .Status "resolved" }}RECOVERED{{ else }}{{ index .Labels "severity" }}{{ end }}
            CHECK    {{ index .Labels "alertname" }}

            {{ index .Annotations "description" }}{% endraw %}
      async: false
