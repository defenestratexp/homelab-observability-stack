# Example only. The Grafana init container reads these to fetch the admin
# password from AWS Secrets Manager (homelab/grafana/admin-password).
# Copy to aws-credentials-secret.yaml (git-ignored), fill in, and apply.
# Use an IAM user scoped to secretsmanager:GetSecretValue on that one secret.
apiVersion: v1
kind: Secret
metadata:
  name: aws-credentials
  namespace: logging-system
type: Opaque
stringData:
  AWS_ACCESS_KEY_ID: CHANGE_ME
  AWS_SECRET_ACCESS_KEY: CHANGE_ME
